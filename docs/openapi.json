  "components": {
    "schemas": {
      "BatchPredictionRequest": {
        "properties": {
          "requests": {
            "items": {
              "$ref": "#/components/schemas/PredictionRequest"
            },
            "type": "array",
            "maxItems": 25,
            "minItems": 1,
            "title": "Requests"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requests"
        ],
        "title": "BatchPredictionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelContribution": {
        "properties": {
          "measurement": {
            "type": "string",
            "title": "Measurement"
          },
          "contribution_percentage_points": {
            "type": "number",
            "title": "Contribution Percentage Points"
          },
          "direction": {
            "type": "string",
            "enum": [
              "increases_model_risk",
              "decreases_model_risk"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "measurement",
          "contribution_percentage_points",
          "direction"
        ],
        "title": "ModelContribution"
      },
      "Patient": {
        "properties": {
          "age": {
            "type": "number",
            "maximum": 110.0,
            "minimum": 18.0,
            "title": "Age"
          },
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "unknown"
            ],
            "title": "Sex",
            "default": "unknown"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 350.0,
                "minimum": 20.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          },
          "admission_type": {
            "type": "string",
            "enum": [
              "emergency",
              "elective",
              "urgent",
              "other",
              "unknown"
            ],
            "title": "Admission Type",
            "default": "unknown"
          },
          "baseline_creatinine": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 30.0,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Creatinine"
          },
          "baseline_hour": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 8760.0,
                "minimum": -168.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Hour"
          },
          "chronic_kidney_disease": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chronic Kidney Disease"
          },
          "diabetes": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diabetes"
          },
          "hypertension": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hypertension"
          },
          "heart_failure": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heart Failure"
          },
          "chronic_dialysis": {
            "type": "boolean",
            "title": "Chronic Dialysis",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "age"
        ],
        "title": "Patient"
      },
      "PredictionRequest": {
        "properties": {
          "patient": {
            "$ref": "#/components/schemas/Patient"
          },
          "at_hour": {
            "type": "number",
            "maximum": 8760.0,
            "minimum": 0.0,
            "title": "At Hour"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Readings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patient",
          "at_hour",
          "readings"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "at_hour": {
            "type": "number",
            "title": "At Hour"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "horizon_hours": {
            "type": "integer",
            "title": "Horizon Hours"
          },
          "status": {
            "type": "string",
            "enum": [
              "predicted",
              "aki_already_observed",
              "outside_new_aki_cohort",
              "insufficient_data"
            ],
            "title": "Status"
          },
          "predicted_risk": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Risk"
          },
          "predicted_risk_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Risk Percent"
          },
          "risk_category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "moderate",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Category"
          },
          "alert": {
            "type": "boolean",
            "title": "Alert"
          },
          "alert_options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Alert Options"
          },
          "alert_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Alert Threshold"
          },
          "clinical_assessment": {
            "additionalProperties": true,
            "type": "object",
            "title": "Clinical Assessment"
          },
          "clinical_summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Clinical Summary"
          },
          "data_quality": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data Quality"
          },
          "model_contributions": {
            "items": {
              "$ref": "#/components/schemas/ModelContribution"
            },
            "type": "array",
            "title": "Model Contributions"
          },
          "input_sensitivity": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Sensitivity"
          },
          "model": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          },
          "lead_time_note": {
            "type": "string",
            "title": "Lead Time Note"
          }
        },
        "type": "object",
        "required": [
          "at_hour",
          "target",
          "horizon_hours",
          "status",
          "predicted_risk",
          "predicted_risk_percent",
          "risk_category",
          "alert",
          "alert_threshold",
          "clinical_assessment",
          "data_quality",
          "model_contributions",
          "model",
          "notice",
          "lead_time_note"
        ],
        "title": "PredictionResponse"
      },
      "Reading": {
        "properties": {
